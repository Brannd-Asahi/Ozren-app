rules_version = '2';

// Reglas de seguridad de Firestore para "Ozren".
// Cada persona autenticada solo puede leer y escribir DENTRO de su propio
// documento de usuario (usuarios/{uid}/...). Nadie puede ver ni tocar los
// datos de otra cuenta, ni siquiera si conoce el uid.

service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
